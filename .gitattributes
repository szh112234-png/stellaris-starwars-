# FOC repository defaults

* text=auto

# Paradox / Stellaris text assets: keep repository diffs stable across Windows and CI.
*.txt text eol=lf
*.mod text eol=lf
*.gui text eol=lf
*.gfx text eol=lf
*.asset text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.py text eol=lf

# Binary game assets: never line-ending normalize.
*.dds binary
*.mesh binary
*.anim binary
*.wav binary
*.ogg binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.ttf binary
