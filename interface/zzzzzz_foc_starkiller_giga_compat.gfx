# Compatibility icons for megastructure-selection UI replacements such as
# Gigastructural Engineering. The UI resolves build-list sprites as
# GFX_<megastructure_type_key>_build_icon.
spriteTypes = {
    spriteType = {
        name = "GFX_myk_starkiller_base_site_build_icon"
        texturefile = "gfx/interface/icons/megastructures/myk_starkiller_build_icon.dds"
        noOfFrames = 1
    }

    spriteType = {
        name = "GFX_myk_starkiller_base_final_build_icon"
        texturefile = "gfx/interface/icons/megastructures/myk_starkiller_build_icon.dds"
        noOfFrames = 1
    }

    # GFX_fop_starkiller_base_site_build_icon already exists in the original
    # FOC small-icon file, so it is intentionally not duplicated here.
    spriteType = {
        name = "GFX_fop_starkiller_base_final_build_icon"
        texturefile = "gfx/interface/icons/megastructures/myk_starkiller_build_icon.dds"
        noOfFrames = 1
    }
}
