							spriteType = {
		name = "GFX_sa_starring_edict"
		texturefile = "gfx/interface/icons/sa_starring_edict.dds"
		alwaystransparent = yes
		animation = {
			animationmaskfile = "gfx/interface/icons/sa_starring_edict.dds"			
			animationtexturefile = "gfx/interface/icons/sa_starring_edict.dds" 	# <- the animated file
			animationrotation = 90.0		# -90 clockwise 90 counterclockwise(by default)
			animationlooping = yes			# yes or no ;)
			animationtime = 0.6				# in seconds
			animationdelay = 8			# in seconds
			animationblendmode = "add"       #add, multiply, overlay
			animationtype = "scrolling"      #scrolling, rotating, pulsing
			animationrotationoffset = { x = 0.0 y = 0.0 }
			animationtexturescale = { x = 1.0 y = 1.0 }
		}
		legacy_lazy_load = no
	}
