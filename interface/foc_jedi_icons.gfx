# Jedi army icons carried over from the Grand Army of the Republic portrait
# pack under FOC's own sprite names, so the pack's GFX_army_type_jedi* sprites
# are never overridden and the icons still resolve when it is not loaded.
spriteTypes = {
	spriteType = {
		name = "GFX_foc_army_type_jedi"
		texturefile = "gfx/interface/icons/armies/foc_jedi_army_icon.dds"
	}
	spriteType = {
		name = "GFX_foc_army_type_jedi_knight"
		texturefile = "gfx/interface/icons/armies/foc_jedi_knight_army_icon.dds"
	}
	spriteType = {
		name = "GFX_foc_army_type_jedi_master"
		texturefile = "gfx/interface/icons/armies/foc_jedi_master_army_icon.dds"
	}

	spriteType = {
		name = "GFX_foc_army_type_jedi_guardian"
		texturefile = "gfx/interface/icons/armies/foc_jedi_guardian_army_icon.dds"
	}
	spriteType = {
		name = "GFX_foc_army_type_jedi_sentinel"
		texturefile = "gfx/interface/icons/armies/foc_jedi_sentinel_army_icon.dds"
	}
	spriteType = {
		name = "GFX_foc_army_type_jedi_consular"
		texturefile = "gfx/interface/icons/armies/foc_jedi_consular_army_icon.dds"
	}
	spriteType = {
		name = "GFX_foc_army_type_jedi_sage"
		texturefile = "gfx/interface/icons/armies/foc_jedi_sage_army_icon.dds"
	}
	spriteType = {
		name = "GFX_foc_army_type_jedi_shadow"
		texturefile = "gfx/interface/icons/armies/foc_jedi_shadow_army_icon.dds"
	}
}
