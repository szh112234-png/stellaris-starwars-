# v17.17g: local visual frames. Frames stay at scale 1.0 on purpose. Visible
# size for these hulls is set by `hull_scale` in common/ship_sizes, which the
# engine applies to the whole assembled ship (frame + sections + turrets).
# Do not reintroduce a scale here: it would stack with hull_scale.
# These entity names also exist to satisfy the names the error log requested.
# Existing section entities provide the one visible hull. Do not add hull attach
# directives here: doing so would render the hull a second time.

entity = {
    name = "foc_v1717f_executor_escort_frame_entity"
    pdxmesh = "imperialsd_frame_mesh"
    scale = 1.0
    default_state = "idle"
}

entity = {
    name = "empire_01_foc_v1717f_executor_escort_frame_entity"
    pdxmesh = "imperialsd_frame_mesh"
    scale = 1.0
    default_state = "idle"
}

