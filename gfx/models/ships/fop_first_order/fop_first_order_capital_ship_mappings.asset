# Lightweight entity mapping only. No mesh or texture is included.
# Requires the original FOC entities: resurgentbattlecruiser_entity and Manator_entity.
# Requires EMPIRE.zip/gfx to be copied into FOC for the hidden locator meshes and fallback ships.

entity = {
    name = "fop_first_order_01_Dreadnought_entity"
    pdxmesh = "mammalian_01_battleship_frame_mesh"
    locator = { name = "fop_complete_hull" position = { 0 0 0 } }
    locator = { name = "part1" position = { 0 0 0 } }
    locator = { name = "part2" position = { 0 0 0 } }
    locator = { name = "part3" position = { 0 0 0 } }
    locator = { name = "part4" position = { 0 0 0 } }
    locator = { name = "part5" position = { 0 0 0 } }
    attach = { fop_complete_hull = "resurgentbattlecruiser_entity" }
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_blend_time = 4 }
    state = { name = "moving" animation = "idle" animation_blend_time = 4 }
    state = { name = "death" animation = "death" animation_blend_time = 0 looping = no }
    game_data = { size = 35.0 }
}

# Lowercase compatibility alias for ship-size mods that use dreadnought instead of Dreadnought.
entity = {
    name = "fop_first_order_01_dreadnought_entity"
    pdxmesh = "mammalian_01_battleship_frame_mesh"
    locator = { name = "fop_complete_hull" position = { 0 0 0 } }
    locator = { name = "part1" position = { 0 0 0 } }
    locator = { name = "part2" position = { 0 0 0 } }
    locator = { name = "part3" position = { 0 0 0 } }
    locator = { name = "part4" position = { 0 0 0 } }
    locator = { name = "part5" position = { 0 0 0 } }
    attach = { fop_complete_hull = "resurgentbattlecruiser_entity" }
    default_state = "idle"
    state = { name = "idle" animation = "idle" animation_blend_time = 4 }
    state = { name = "moving" animation = "idle" animation_blend_time = 4 }
    state = { name = "death" animation = "death" animation_blend_time = 0 looping = no }
    game_data = { size = 35.0 }
}

