entity = {
	name = "rebel_01_Battlecruiser_entity"
	pdxmesh = "mammalian_01_battleship_frame_mesh"

###	locator = { name = "part1"	position = { 0 0 0 } }
	locator = { name = "part2"	position = { 0 0.3 -6 } }
	locator = { name = "part3"	position = { 0 0.3 -6 } }
	locator = { name = "part4"	position = { 0 0.3 -6 } }

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 4 }
	state = { name = "moving" animation = "idle" animation_blend_time = 4 }

		### Maximum Death Sequence Time ~ 14.5 Seconds
		### 3 Death Animations x 4 Death Sequences per ship = 12 Different Death Scenes per ship
	state = { name = "death" animation = "death" animation_blend_time = 0 chance = 1 looping = no
		event = { time = 14.5 node = "part1" particle = "large_player_ship_explosion_particle" sound = { soundeffect = ship_destroyed } } }
	state = { name = "death" animation = "death2" animation_blend_time = 0 chance = 1 looping = no
		event = { time = 22.5 node = "part1" particle = "large_player_ship_explosion_particle" sound = { soundeffect = ship_destroyed } } }
	state = { name = "death" animation = "death3" animation_blend_time = 0 chance = 1 looping = no
		event = { time = 15.9 node = "part1" particle = "large_player_ship_explosion_particle" sound = { soundeffect = ship_destroyed } } }

	game_data = {
		size = 24.0
	}
}

