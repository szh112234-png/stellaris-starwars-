##########
# FLAGSHIP
##########

##########
# FRAME
##########

entity = {
	name = "cis_01_Flagship_entity"
	pdxmesh = "mammalian_01_titan_frame_mesh"

###	locator = { name = "part1"	position = { 0 0 0 } }
	locator = { name = "part2"	position = { 0 0 -12.5 } }
	locator = { name = "part3"	position = { 0 0 -12.5 } }
	locator = { name = "part4"	position = { 0 0 -12.5 } }
	locator = { name = "part5"	position = { 0 0 -12.5 } }
	locator = { name = "part6"	position = { 0 0 -12.5 } }

	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 4 }
	state = { name = "moving" animation = "idle" animation_blend_time = 4 }

		### Maximum Death Sequence Time ~ 12.5 Seconds
		### Due to the size and significance of the ship, only 1 Death Animation is really needed here
	state = { name = "death" animation = "death" animation_blend_time = 0 looping = no 
		event = { time = 12.5 node = "part1" particle = "juggernaut_explosion_particle" sound = { soundeffect = "amb_titan_ship_death" } } }

	game_data = {
		size = 60.0
	}
}

##########
# SPECIAL
##########

entity = {
	name = "cis_subjugator_shield_entity"
	pdxmesh = "cis_subjugator_shield_mesh"
	
	game_data = {
		uv_animation_speed   = -0.05
		uv_animation_direction  = { 0.0 1.0 }
	}
}

