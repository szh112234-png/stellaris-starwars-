##########
# CIVILIAN STATIONS
##########

##########
# SPECIAL
##########

entity = {
	name = "cis_spacedock_1_shield_entity"
	pdxmesh = "cis_spacedock_1_shield_mesh"
	
	game_data = {
		uv_animation_speed   = -0.05
		uv_animation_direction  = { 0.0 1.0 }
	}
}

##########
# MINING STATION
##########

entity = {
	name = "cis_01_mining_station_entity"
	pdxmesh = "cis_spacedock_3_mesh"
	scale = 1.0

	default_state = "idle"
	state = { name = "idle" state_time = 5
		start_event = { trigger_once = yes sound = { soundeffect = "amb_mining_station_signals" } }
	}

	### Static Death Animation / 3 Second Animation
	state = { name = "death" state_time = 3 looping = no
		event = { time = 2.9 particle = "large_player_ship_explosion_particle" sound = { soundeffect = "station_explosion_large" } }
	}

	game_data = {
		size = 12.0
	}
}

entity = {
	name = "cis_01_mining_station_section_entity"
	pdxmesh = "sw_empty_mesh"
}

entity = {
	name = "cis_01_mining_station_construction_entity"
	pdxmesh = "cis_spacedock_3_mesh"
	scale = 1.0

	default_state = "idle"
	state = { name = "idle" state_time = 5
	event = { trigger_once = yes sound = { soundeffect = "place_construction" } } }
}

##########
# RESEARCH STATION
##########

entity = {
	name = "cis_01_research_station_entity"
	pdxmesh = "cis_spacedock_1_mesh"
	scale = 0.65

	locator = { name = "root" rotation = { 0 0 0 } position = { 0 0 0 } }
	attach = { root = "cis_spacedock_1_shield_entity" }

	default_state = "idle"
	state = { name = "idle" state_time = 5
		start_event = { trigger_once = yes sound = { soundeffect = "amb_research_station_signals" } }
	}

	### Static Death Animation / 3 Second Animation
	state = { name = "death" state_time = 3 looping = no
		event = { time = 2.9 particle = "dreadnought_explosion_particle" sound = { soundeffect = "station_explosion_large" } }
	}

	game_data = {
		size = 12.0
	}
}

entity = {
	name = "cis_01_research_station_section_entity"
	pdxmesh = "sw_empty_mesh"
}

entity = {
	name = "cis_01_research_station_construction_entity"
	pdxmesh = "cis_spacedock_1_mesh"
	scale = 0.65

	default_state = "idle"
	state = { name = "idle" state_time = 5
	event = { trigger_once = yes sound = { soundeffect = "place_construction" } } }
}

