##########
# Phase I
##########

entity = {
	name = "empire_01_mega_shipyard_01_stage_1_entity"
	pdxmesh = "empire_shipyard_L1_mesh"
	scale = 2.0

	default_state = "idle"
	state = { name = "idle" state_time = 5
		start_event = { trigger_once = yes sound = { soundeffect = "amb_outpost_station_idle" } }
	}
}

