##########
# Juggernaut
##########

##########
# FRAME
##########

entity = {
	# FOC designer preview fix:
	# 2829069669 accidentally named the Empire frame republic_01_juggernaut_entity,
	# which both overwrote the Republic entity and left empire_01_juggernaut_entity
	# undefined. The actual Annihilator hull is supplied by the core section below.
	name = "empire_01_juggernaut_entity"
	pdxmesh = "sw_empty_mesh"

	locator = { name = "part1" position = { 0 0 0 } }

	default_state = "idle"
	state = { name = "idle" }
	state = { name = "moving" }
	state = { name = "death" state_time = 0.3 looping = no }

	game_data = {
		size = 38.0
	}
}

##########
# SPECIAL
##########

entity = {
	name = "empire_annihilator_mounts_left_entity"
	pdxmesh = "empire_annihilator_mounts_left_mesh"
}

entity = {
	name = "empire_annihilator_mounts_right_entity"
	pdxmesh = "empire_annihilator_mounts_right_mesh"
}

