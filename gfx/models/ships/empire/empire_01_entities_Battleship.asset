##########
# FRAME
##########

entity = {
	# FOC designer preview fix:
	# The original 2829069669 file used the vanilla mammalian battleship frame
	# here. The visible Imperial hull is already supplied by the selected Empire
	# section entity, so keep this frame invisible while retaining section anchors.
	name = "empire_01_battleship_entity"
	# FOC hotfix: required section attachment reported missing by the engine.
	locator = { name = "part2" position = { 0 0 0 } }
	pdxmesh = "sw_empty_mesh"

	locator = { name = "part1" position = { 0 0 0 } }
	locator = { name = "part3" position = { 0 0 0 } }

	default_state = "idle"
	state = { name = "idle" }
	state = { name = "moving" }
	state = { name = "death" state_time = 0.3 looping = no }

	game_data = {
		size = 20.0
	}
}

