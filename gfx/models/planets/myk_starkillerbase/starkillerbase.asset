#Megastructure
entity = {
	name = "myk_starkillerbase_megastructure_entity"
	locator = { name = "myk_starkillerbase_rotation" position = { 0 0 0 } rotation = { -42 142 0 } }
	attach = { "myk_starkillerbase_rotation" = "myk_starkillerbase_planet_entity" }
	game_data = { emissive_recolor_crunch = 0 }
}

entity = {
	name = "myk_starkillerbase_megastructure_firing_entity"
	locator = { name = "myk_starkillerbase_rotation" position = { 0 0 0 } rotation = { -42 142 0 } }
	attach = { "myk_starkillerbase_rotation" = "myk_starkillerbase_firing_planet_entity" }
	game_data = { emissive_recolor_crunch = 0 }
}

###################################################
entity = {
	name = "myk_starkillerbase_planet_entity"
	pdxmesh = "myk_starkillerbase_planet_mesh"
	default_state = "idle"
	state = { name = "idle" state_time = 5.0
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class" } }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class_02" } }
	}
	game_data = { emissive_recolor_crunch = 0 }
}

entity = {
	name = "myk_starkillerbase_firing_planet_entity"
	pdxmesh = "myk_starkillerbase_planet_mesh"
	attach = { "lazer_2" = "myk_starkillerbase_beamlaser_entity" }
}

###############################################megastructure fire entity######################################################################

#Starkiller Laser Beam
entity = { 
	name = "myk_starkillerbase_beamlaser_entity" #lazer beam effect entity	
	default_state = "idle"
	state = { 
		name = "idle" state_time = 1
		event = { time = 0.0 node = "polar_effect_1" particle = "myk_starkiller_red_beam"  keep_particle = no trigger_once = yes  sound = { soundeffect = "pulsar_star_idle_hum" } }
	}
	game_data = { uv_animation_speed = -0.1 uv_animation_direction = { 0.4 0.4 } bloom_factor = 0.5 }	
}

entity = {
	name = "myk_starkiller_market_fire_beam_base_entity"
	default_state = "idle"
	state = { 
		name = "idle" state_time = 1
		event = { time = 0.0 node = "polar_effect_1" particle = "myk_starkiller_planet_red_beam"  keep_particle = no trigger_once = yes  sound = { soundeffect = "pulsar_star_idle_hum" } }
	}
	game_data = { uv_animation_speed = -0.1 uv_animation_direction = { 0.4 0.4 } bloom_factor = 0.5 }	
}

