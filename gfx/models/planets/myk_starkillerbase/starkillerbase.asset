# (Removed broken "TARGET MARGET" stub that referenced the missing Kuat
#  "ring_world_ration_back_mesh". The working replacement entity of the
#  same name is defined below under "Standalone fixes".)


#Starkiller sun drain TEMP 
entity = {
	name = "myk_starkiller_sun_drain"
	default_state = "idle"
	state = { name = "idle" state_time = 1
		event = { time = 0.0 node = "polar_effect_1" particle = "myk_starkiller_sundrain_beam"  keep_particle = no trigger_once = yes  sound = { soundeffect = "pulsar_star_idle_hum" } }
	}
	scale = 5
	game_data = { uv_animation_speed  = -0.1 uv_animation_direction = { 0.4 0.4 } bloom_factor = 0.5 }
}


# ---- Standalone fixes: override broken Kuat dependencies ----
entity = {
    name = "myk_starkiller_invisible_entity"
    default_state = "idle"
    state = { name = "idle" state_time = 5.0 }
}

# Replaces original ringworld-ration marker that required missing Kuat ringworld mesh.
entity = {
    name = "myk_starkiller_ring_world_second_back_ration_entity"
    pdxmesh = "myk_starkillerbase_planet_mesh"
    scale = 0.02
    default_state = "idle"
    state = { name = "idle" state_time = 5.0 }
}

# Simple marker for target impact animation, using the planet laser particle.
entity = {
    name = "myk_starkiller_target_impact_entity"
    default_state = "idle"
    state = {
        name = "idle"
        state_time = 30.0
        event = {
            time = 0.0
            node = "root"
            particle = "myk_starkiller_planet_red_beam"
            keep_particle = yes
            trigger_once = yes
            sound = { soundeffect = "myk_starkillerbase_fire" }
        }
    }
}

