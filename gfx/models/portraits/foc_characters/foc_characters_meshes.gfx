# Mesh used by the Emperor's throne-room portrait. The Galactic Empire portrait
# pack owns the original; this copy is namespaced so the pack's own
# portrait_sith_* meshes are never overridden when both are loaded.
objectTypes = {
	pdxmesh = {
		name = "foc_portrait_sith_mesh"
		file = "gfx/models/portraits/foc_characters/foc_sith_01.mesh"
		animation = { id = "idle"	type = "human_male_05_happy_animation" }
		animation = { id = "idle2"	type = "human_male_05_happy_2_animation" }
		animation = { id = "sad"	type = "human_male_05_sad_animation" }
		animation = { id = "sad2"	type = "human_male_05_sad_2_animation" }

		scale = 1.8
	}
}
