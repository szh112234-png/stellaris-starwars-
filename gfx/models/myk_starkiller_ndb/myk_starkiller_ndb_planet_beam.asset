    name = "myk_starkiller_ndb_enemy_firing_4_entity"
    cull_radius = 1000
    locator = { name = "root" position = { 0 0 0 } }
    locator = { name = "m1" position = { 0 0 -300 } rotation = { 0 -90 0 } }
