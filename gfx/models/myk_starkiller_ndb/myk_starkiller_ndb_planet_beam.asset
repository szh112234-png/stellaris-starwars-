# The ambient object is anchored to the target planet and faces the local star.
# The beam assembly extends in the opposite radial direction, creating a clear
# outside-the-system-to-planet incoming beam instead of a star-centred beam.
entity = {
    name = "myk_starkiller_ndb_planet_open_entity"
    cull_radius = 1000
    locator = { name = "m1" position = { 0 185 0 } rotation = { -90 0 0 } scale = 0.2 }
    attach = { m1 = "myk_starkiller_ndb_portal_entity" }
}

entity = {
    name = "myk_starkiller_ndb_planet_firing_4_entity"
    cull_radius = 1000
    locator = { name = "m1" position = { 0 150 0 } rotation = { 0 -90 0 } scale = 0.2 }
    attach = { m1 = "myk_starkiller_ndb_enemy_firing_4_entity" }
}
