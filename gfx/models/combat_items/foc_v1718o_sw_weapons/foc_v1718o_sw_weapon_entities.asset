	cull_radius = 0.5
	
	state = { name = "explode_med_hp" state_time = 5 looping = no
		event = { time = 0.0 node = "root" particle = "foc_v1718o_red_blaster_small_hit_effect" sound = { soundeffect = foc_v1718o_sw_hull_hit } }
