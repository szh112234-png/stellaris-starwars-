# FOC v17.18o: faction-coloured Star Wars weapon visuals and sounds.
# Assets adapted from the uploaded Star Wars Weapons (common.zip) and SWFO sound pack;
# every identifier is prefixed foc_v1718o_ so other installed Star Wars mods cannot collide.

entity = {
	name = "foc_v1718o_ion_g_large_muzzle_entity"
	cull_radius = 1.0
	default_state = "idle"
	state = { name = "idle" state_time = 7 looping = no
		event = { time = 0 particle = "foc_v1718o_green_turbolaser_large_muzzle_particle" keep_particle = yes sound = { soundeffect = foc_v1718o_ion_cannon } }
		event = { trigger_once = yes sound = { soundeffect = "foc_v1718o_distance_ion_cannon" } }
	}
}

