# MUZZLE FLASH

entity = {
	name = "swgs_turbolaser_small_muzzle_entity"
	cull_radius = 1.0
	
	default_state = "idle"
	state = { name = "idle" state_time = 7 looping = no
		event = { time = 0 particle = "swgs_turbolaser_small_muzzle_particle" keep_particle = yes sound = { soundeffect = turbo_heavy_01} }
		event = { trigger_once = yes sound = { soundeffect = "distance_turbo_heavy_01" } }
	}
}

